PORT=3001

# Running the api directly on the host (pnpm dev:api) against the local
# docker-compose.yml postgres, which is published on host port 5434:
DATABASE_URL=postgres://postgres:postgres@localhost:5434/aelc

# Running the api itself inside docker compose (api/web/postgres services
# in the same docker-compose.yml): use the service name and container
# port instead — "localhost" inside the api container is the container,
# not the postgres one.
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/aelc

CORS_ORIGIN=http://localhost:3000
