PORT=3001

# Default: point at the shared dev/production Postgres on the LAN so every
# developer works against the same data without running Postgres locally.
DATABASE_URL=postgres://postgres:postgres@192.168.8.64:5434/aelc

# Alternative: run Postgres locally via the repo's docker-compose.yml
# (`docker compose up -d postgres`), published on host port 5434:
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/aelc

# Alternative: running the api itself inside docker compose (api/web/postgres
# services in the same docker-compose.yml) — use the service name and
# container port instead, since "localhost" inside the api container is the
# container, not the postgres one:
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/aelc

CORS_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Central AELC consumer API (see docs/superpowers/specs/2026-09-17-central-consumer-api-and-aelc-platform-sync-design.vi.md).
# CONSUMER_API_TOKEN is issued out-of-band by the AELC side's admin CLI
# (`engineering central admin consumer issue`) — not generated here.
CONSUMER_API_BASE_URL=https://central.example.com
CONSUMER_API_TOKEN=replace-with-issued-consumer-credential
